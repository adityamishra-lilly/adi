---
import Sun from './icons/Sun.astro';
import Moon from './icons/Moon.astro';
---
<button type="button" class="toggle" data-theme-toggle aria-label="Toggle colour theme" title="Toggle colour theme">
  <Moon size={22} class="icon-moon" />
  <Sun size={22} class="icon-sun" />
</button>

<style>
  .toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: var(--text);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition:
      color var(--transition),
      border-color var(--transition);
  }

  .toggle:hover {
    color: var(--accent);
    border-color: var(--border);
  }

  /* Moon in dark mode, sun in light mode. Pure CSS, so no JS is needed to swap icons. */
  .toggle :global(.icon-sun) {
    display: none;
  }

  :global(:root[data-theme='light']) .toggle :global(.icon-sun) {
    display: block;
  }

  :global(:root[data-theme='light']) .toggle :global(.icon-moon) {
    display: none;
  }
</style>
