---
import type { Category } from '../lib/notes';

interface Props {
  categories: Category[];
  total: number;
  /** Slug of the selected category; undefined means "All". */
  active?: string;
  /** List root, e.g. "/notes/". Category pages live under `${baseHref}category/<slug>/`. */
  baseHref: string;
}

const { categories, total, active, baseHref } = Astro.props;
const chips = [
  { label: 'All', count: total, href: baseHref, current: active === undefined },
  ...categories.map((c) => ({
    label: c.name,
    count: c.count,
    href: `${baseHref}category/${c.slug}/`,
    current: c.slug === active,
  })),
];
---
<nav aria-label="Filter by category">
  <ul class="chips">
    {
      chips.map((chip) => (
        <li>
          <a href={chip.href} aria-current={chip.current ? 'page' : undefined}>
            {chip.label}
            <span class="count">{chip.count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    transition: border-color var(--transition);
  }

  a:hover {
    border-color: var(--accent);
  }

  .count {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  a[aria-current='page'] {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }

  a[aria-current='page'] .count {
    color: inherit;
  }
</style>
