---
import TagList from './TagList.astro';
import { formatShortDate, noteHref, type Note } from '../lib/notes';

interface Props {
  note: Note;
}

const { note } = Astro.props;
---
<article class="row">
  <time datetime={note.data.date.toISOString().slice(0, 10)}>{formatShortDate(note.data.date)}</time>
  <div>
    <h3 class="title"><a href={noteHref(note)}>{note.data.title}</a></h3>
    <TagList category={note.data.category} tags={note.data.tags} />
  </div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-2);
    border-radius: var(--radius-card);
    transition: background-color var(--transition);
  }

  .row:hover,
  .row:focus-within {
    background: var(--surface);
  }

  time {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    white-space: nowrap;
  }

  .title {
    margin-bottom: var(--space-2);
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.4;
  }

  .title a {
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
  }

  @media (min-width: 600px) {
    .row {
      grid-template-columns: 4.5rem 1fr;
      gap: var(--space-3);
      padding-inline: var(--space-3);
    }

    time {
      padding-top: 0.15rem;
    }
  }
</style>
